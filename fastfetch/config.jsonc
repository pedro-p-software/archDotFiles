{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
 "logo": {
    "type": "auto",        // Logo type: auto, builtin, small, file, etc.
    "source": "/mnt/os/pedro/Documents/fastfetchspiderlogo.txt",      // Built-in logo name or file path
    "width": 1,           // Width in characters
    "height": 1,          // Height in characters
    "padding": {
        "top": 0,          // Top padding
        "left": 0,         // Left padding
        "right": 2         // Right padding
    },
    "color": {             // Override logo colors
        "1": "red",
    }
 },
	 
"display":{
"color":{
	"keys": "blue",
	"output": "white",

  },
"brightColor":true
	 },
 "modules": [
    {
	"type": "title",
	"key": "Dono",
	"keyColor": "blue",
	"format": "{#red}{host-name}"
    },

    {
        "type": "custom",
	"keyColor": "white",
	"format": "{#red}╭───────────────────────────────────────╮"				
    },

    {
        "type": "os",
        "key": "OS",
        "keyColor": "blue",
        "format": "{name} btw"
    },
    "packages",
    "shell",
    "de",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "locale",

    {
    "type": "custom",
    "keyColor": "white",
    "format": "{#red}╰───────────────────────────────────────╯"
    },
	    
    "break",
  ]
}
